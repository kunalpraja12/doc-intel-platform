POSTGRES_DB=docintel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/docintel
# Gemini is required for extraction, embeddings, and chat.
GEMINI_API_KEY=your_key_here
# Optional fallback model for repeated Gemini 503 errors.
GEMINI_FALLBACK_MODEL=

# Optional: full path to the tesseract executable. If set, OCR will use this
# binary. On Windows install path example (do not commit secrets):
# TESSERACT_CMD="C:\Program Files\Tesseract-OCR\tesseract.exe"
TESSERACT_CMD=
